generator client {
  // The client-side query compiler (`engineType = "client"`) ships as WebAssembly
  // inside the npm packages, so no native query engine is downloaded at install or
  // build time. It is required for driver adapters, which is how this app reaches
  // Turso/libSQL.
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")

  /**
   * Turso is libSQL (SQLite), but foreign keys stay in the database exactly as they
   * were under MySQL/InnoDB: the libSQL driver (local file and hosted Turso alike)
   * runs with `PRAGMA foreign_keys = ON`, so `onDelete: Cascade` / `SetNull` fire
   * in SQLite itself. `src/config/prisma.ts` asserts that pragma on every new
   * connection and logs loudly if a server ever reports it off.
   *
   * `relationMode = "prisma"` was deliberately NOT used: Prisma's client-side
   * emulation rejects the implicit `onUpdate: Cascade` that SQLite self-relations
   * (folders.parent, upload_sessions.folder) require, so it cannot express this
   * schema.
   */
}

model User {
  id             String             @id @default(uuid())
  name           String
  email          String             @unique
  passwordHash   String             @map("password_hash")
  status         String             @default("active")
  /**
   * Server-verified role. New accounts are least-privileged `visitor`; existing
   * rows keep whatever role they already have. `SUPER_ADMIN_EMAILS` can grant
   * `super_admin` without a database edit, and a super admin can explicitly
   * promote accounts through the admin API. Never read a role from a request body.
   */
  role           String             @default("visitor")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  sessions       UserSession[]
  authHandoffs   AuthHandoff[]
  providerConfigs ProviderConfig[]
  oauthStates    OauthState[]
  connectedAccounts ConnectedAccount[]
  s3StorageConfigs S3StorageConfig[]
  files          File[]
  fileShares     FileShare[]
  filePreviewTokens FilePreviewToken[]
  folders        Folder[]
  uploadSessions UploadSession[]
  auditLogs      AuditLog[]
  workspaceInvitesSent WorkspaceInvite[] @relation("WorkspaceInvitesSent")
  uploadRoutingPolicy UploadRoutingPolicy?
  apiKeys       ApiKey[]
  /** "Notify me" votes on unreleased features. */
  featureVotes  FeatureVote[]
  /** Every point this account has earned or had reversed. */
  pointsLedger  PointsLedgerEntry[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @unique @map("key_hash")
  /** JSON array of scope strings, stored as text. */
  scopes     String
  status     String    @default("active")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rateLimitWindows ApiKeyRateLimitWindow[]

  @@index([userId])
  @@index([userId, status, createdAt])
  @@map("api_keys")
}

/**
 * Shared, persistent one-minute API-key request budget. Only used when
 * API_RATE_LIMIT_STORAGE=database (multi-instance deployments); the default
 * single-instance limiter stays in memory and writes no rows.
 */
model ApiKeyRateLimitWindow {
  id          String   @id @default(uuid())
  apiKeyId    String   @map("api_key_id")
  windowStart DateTime @map("window_start")
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, windowStart])
  @@index([windowStart])
  @@map("api_key_rate_limit_windows")
}

model UploadRoutingPolicy {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  mode               String   @default("most_available")
  /** JSON array of account ids, stored as text (SQLite has no Json scalar). */
  priorityAccountIds String   @default("[]") @map("priority_account_ids")
  roundRobinCursor   Int      @default(0) @map("round_robin_cursor")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("upload_routing_policies")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model AuthHandoff {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_handoffs")
}

model ProviderConfig {
  id                    String             @id @default(uuid())
  userId                String?            @map("user_id")
  provider              String
  clientIdEncrypted     String             @map("client_id_encrypted")
  clientSecretEncrypted String             @map("client_secret_encrypted")
  redirectUri           String             @map("redirect_uri")
  /** JSON array of scope strings, stored as text. */
  scopes                String
  status                String             @default("active")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  user                  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  oauthStates           OauthState[]
  connectedAccounts     ConnectedAccount[]

  @@index([userId])
  @@index([provider])
  @@map("provider_configs")
}

model OauthState {
  id               String         @id @default(uuid())
  userId           String?        @map("user_id")
  providerConfigId String         @map("provider_config_id")
  flow             String         @default("connect")
  stateHash        String         @unique @map("state_hash")
  expiresAt        DateTime       @map("expires_at")
  usedAt           DateTime?      @map("used_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig   ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerConfigId])
  @@map("oauth_states")
}

model ConnectedAccount {
  id                    String          @id @default(uuid())
  userId                String          @map("user_id")
  providerConfigId      String?         @map("provider_config_id")
  provider              String
  providerAccountId     String          @map("provider_account_id")
  email                 String
  displayName           String?         @map("display_name")
  avatarUrl             String?         @map("avatar_url")
  accessTokenEncrypted  String?         @map("access_token_encrypted")
  refreshTokenEncrypted String?         @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?       @map("token_expires_at")
  /** JSON array of scope strings, stored as text. */
  scopes                String
  status                String          @default("connected")
  lastError             String?         @map("last_error")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig        ProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  storageAccount        StorageAccount?
  files                 File[]
  folders               Folder[]
  uploadSessions        UploadSession[]
  s3StorageConfig       S3StorageConfig?

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
  @@index([userId, status, createdAt])
  @@index([providerConfigId])
  @@map("connected_accounts")
}

model S3StorageConfig {
  id                       String           @id @default(uuid())
  userId                   String           @map("user_id")
  connectedAccountId       String           @unique @map("connected_account_id")
  name                     String
  bucket                   String
  region                   String
  endpoint                 String?         
  accessKeyIdEncrypted     String           @map("access_key_id_encrypted")
  secretAccessKeyEncrypted String           @map("secret_access_key_encrypted")
  forcePathStyle           Boolean          @default(false) @map("force_path_style")
  prefix                   String           @default("9drive")
  quotaBytes               BigInt?          @map("quota_bytes")
  status                   String           @default("active")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount         ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("s3_storage_configs")
}

model StorageAccount {
  id                 String           @id @default(uuid())
  connectedAccountId String           @unique @map("connected_account_id")
  totalBytes         BigInt?          @map("total_bytes")
  usedBytes          BigInt           @default(0) @map("used_bytes")
  availableBytes     BigInt?          @map("available_bytes")
  trashBytes         BigInt?          @map("trash_bytes")
  lastSyncedAt       DateTime?        @map("last_synced_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("storage_accounts")
}

model File {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  connectedAccountId String           @map("connected_account_id")
  folderId           String?          @map("folder_id")
  provider           String
  providerFileId     String           @map("provider_file_id")
  name               String
  mimeType           String           @map("mime_type")
  sizeBytes          BigInt           @map("size_bytes")
  checksum           String?
  /**
   * S3-style object path (`assets/hero.jpg`). Null for files uploaded through the
   * dashboard, which are addressed by id instead. Unique per user, so PUT to the
   * same key overwrites - the behaviour every S3 client expects.
   */
  objectKey          String?          @map("object_key")
  /**
   * Educational resource registry. These columns are additive: a normal
   * dashboard file has them all null/false and behaves exactly as before.
   * `isResource` marks a row Edvanta may discover; `id` is the stable
   * application-level identifier, while `provider` + `providerFileId` +
   * `connectedAccountId` locate the bytes at Google Drive or S3.
   */
  isResource         Boolean          @default(false) @map("is_resource")
  title              String?
  description        String?         
  category           String?
  subject            String?
  academicLevel      String?          @map("academic_level")
  examType           String?          @map("exam_type")
  visibility         String           @default("private")
  clientRequestId    String?          @map("client_request_id")
  /** JSON object with catalog extras, stored as text. */
  resourceMetadata   String?          @map("resource_metadata")
  uploadedBy         String?          @map("uploaded_by")
  lastModifiedBy     String?          @map("last_modified_by")
  /** available | missing | inaccessible | unknown - never inferred from the row alone. */
  availability       String           @default("unknown")
  lastVerifiedAt     DateTime?        @map("last_verified_at")
  status             String           @default("active")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  folder             Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares             FileShare[]
  previewTokens      FilePreviewToken[]

  @@index([userId])
  @@index([userId, status, createdAt])
  @@index([userId, status, folderId, createdAt])
  @@index([userId, isResource, status, createdAt])
  @@index([userId, category])
  @@index([userId, subject])
  @@index([userId, academicLevel])
  @@index([userId, examType])
  @@unique([userId, objectKey])
  @@unique([userId, clientRequestId])
  @@index([connectedAccountId])
  @@index([folderId])
  @@index([providerFileId])
  @@map("files")
}

model FileShare {
  id        String    @id @default(uuid())
  fileId    String    @map("file_id")
  userId    String    @map("user_id")
  token     String?   @unique
  tokenHash String    @unique @map("token_hash")
  enabled   Boolean   @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  file      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
  @@index([userId, enabled, createdAt])
  @@index([fileId, userId, enabled, createdAt])
  @@map("file_shares")
}

model FilePreviewToken {
  id        String   @id @default(uuid())
  fileId    String   @map("file_id")
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
  @@map("file_preview_tokens")
}

model Folder {
  id                 String            @id @default(uuid())
  userId             String            @map("user_id")
  parentId           String?           @map("parent_id")
  connectedAccountId String?           @map("connected_account_id")
  provider           String            @default("google_drive")
  providerFolderId   String?           @map("provider_folder_id")
  name               String
  color              String            @default("text-blue-500")
  iconUrl            String?           @map("icon_url")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent             Folder?           @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           Folder[]          @relation("FolderChildren")
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  files              File[]
  uploadSessions     UploadSession[]    @relation("UploadSessionFolder")

  @@index([userId])
  @@index([userId, deletedAt, updatedAt])
  @@index([userId, deletedAt, parentId, updatedAt])
  @@index([parentId])
  @@index([connectedAccountId])
  @@map("folders")
}

model UploadSession {
  id                       String            @id @default(uuid())
  userId                   String            @map("user_id")
  targetConnectedAccountId String?           @map("target_connected_account_id")
  folderId                 String?           @map("folder_id")
  fileName                 String            @map("file_name")
  mimeType                 String            @map("mime_type")
  sizeBytes                BigInt            @map("size_bytes")
  status                   String
  googleSessionUri         String?           @map("google_session_uri")
  errorMessage             String?           @map("error_message")
  createdAt                DateTime          @default(now()) @map("created_at")
  completedAt              DateTime?         @map("completed_at")
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetConnectedAccount   ConnectedAccount? @relation(fields: [targetConnectedAccountId], references: [id], onDelete: SetNull)
  folder                   Folder?           @relation("UploadSessionFolder", fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@index([targetConnectedAccountId])
  @@map("upload_sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  /** JSON object, stored as text. */
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

model WorkspaceInvite {
  id           String    @id @default(uuid())
  inviterId    String    @map("inviter_id")
  inviteeEmail String    @map("invitee_email")
  targetType   String    @default("file") @map("target_type")
  targetId     String    @default("") @map("target_id")
  role         String    @default("viewer")
  status       String    @default("pending")
  revokedAt    DateTime? @map("revoked_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  inviter      User      @relation("WorkspaceInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([inviterId, inviteeEmail, targetType, targetId], map: "workspace_invites_target_unique")
  @@index([inviteeEmail])
  @@index([targetType, targetId])
  @@index([inviterId])
  @@map("workspace_invites")
}

/**
 * A not-yet-released capability shown on the Coming Soon page.
 *
 * The catalogue lives in the database rather than in a hard-coded array so an
 * administrator can add, reorder, retitle or ship a feature without a deploy -
 * which is the whole point of having the page in the first place.
 */
model ComingSoonFeature {
  id        String   @id @default(uuid())
  /** Stable identifier used in URLs and votes. Never reused after a rename. */
  key       String   @unique
  title     String
  summary   String
  /** Longer "what it will do" copy, shown when the card is expanded. */
  description String?
  /** Grouping label, e.g. "Learning" or "Library". */
  category  String   @default("General")
  /** lucide-react icon name, so the UI needs no per-feature code. */
  icon      String   @default("Sparkles")
  /** `coming_soon` | `beta` | `live` | `paused`. */
  status    String   @default("coming_soon")
  /** Lower sorts first. Ties break on title, so ordering is always stable. */
  sortOrder Int      @default(100) @map("sort_order")
  /** Shown as a "targeting <quarter>" note when set. */
  targetRelease String? @map("target_release")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  votes     FeatureVote[]

  @@index([status, sortOrder])
  @@map("coming_soon_features")
}

/** One account's "notify me" on one feature. Unique per pair. */
model FeatureVote {
  id        String   @id @default(uuid())
  featureId String   @map("feature_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  feature   ComingSoonFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([featureId, userId])
  @@index([userId])
  @@map("feature_votes")
}

/**
 * How many HXP points one kind of learning activity is worth.
 *
 * Admin-editable on purpose: the value of reading a chapter, writing notes,
 * passing a test and finishing a video are policy decisions that change per
 * course and per term. One row per activity type keeps the rule table small
 * and makes "what is reading worth?" a single lookup rather than a code change.
 */
model PointsRule {
  id       String   @id @default(uuid())
  /** `reading` | `notes` | `test` | `video` - fixed by the app, see HXP_ACTIVITIES. */
  activity String   @unique
  label    String
  description String?
  /** Points awarded once the activity is verified. */
  points   Int      @default(10)
  /**
   * Extra points for a strong result (a test score, a long note). Added to
   * `points` when the submission reports a value at or above `bonusThreshold`.
   */
  bonusPoints    Int @default(0) @map("bonus_points")
  /** 0-100. A test score, or a completion percentage. 0 disables the bonus. */
  bonusThreshold Int @default(0) @map("bonus_threshold")
  /** 0 means "no cap". Enforced per user per calendar day (UTC). */
  dailyCap Int      @default(0) @map("daily_cap")
  enabled  Boolean  @default(true)
  updatedById String? @map("updated_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("points_rules")
}

/**
 * The HXP ledger: one row per award, never an overwritten running total.
 *
 * A running total can only be corrected by editing it, which loses the reason.
 * Append-only rows mean a learner can see "why am I on 340?", an administrator
 * can reverse a bad award without guesswork, and the balance is a sum that can
 * always be recomputed from the same data the UI shows.
 */
model PointsLedgerEntry {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  /** Activity type that earned it, matching PointsRule.activity. */
  activity   String
  /** Points actually added: rule points, bonus, or a negative reversal. */
  points     Int
  /** Rule values snapshotted at award time, so later rule edits are not silent history rewrites. */
  rulePoints Int      @default(0) @map("rule_points")
  bonusPoints Int     @default(0) @map("bonus_points")
  /** Which file or video the activity was about, when the client sends one. */
  fileId     String?  @map("file_id")
  /** Free-text note or the client's own reference id. */
  note       String?
  /** Idempotency key: a retried submission must not pay twice. */
  reference  String?  @unique
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, activity, createdAt])
  @@map("points_ledger")
}

/**
 * A track in the upcoming Songs library.
 *
 * "Listing songs" is announced on the Coming Soon page, but the catalogue is
 * real: it is what the page renders as a preview and what the library will open
 * with. Nothing here streams audio yet - that is the unreleased part.
 */
model Song {
  id        String   @id @default(uuid())
  title     String
  artist    String
  album     String?
  /** Seconds; 0 when unknown. */
  durationSeconds Int @default(0) @map("duration_seconds")
  /** `focus` | `study` | `ambient` | ... Free-form, but lower-case. */
  genre     String   @default("study")
  /** Cover art URL, or null for a generated tile. */
  artworkUrl String? @map("artwork_url")
  /** Sort/section hint, e.g. "Featured". */
  collection String  @default("Featured")
  enabled   Boolean  @default(true)
  sortOrder Int      @default(100) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled, sortOrder])
  @@map("songs")
}
