# 9Drive backend environment template.
#
# Copy this file to `backend/.env` (or just run `npm run env:setup` in `backend/`,
# which creates it for you with random secrets):
#
#   cd backend && npm run env:setup
#
# `backend/.env` is git-ignored - never commit real secrets.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MySQL connection string. Prisma refuses to run without it
# ("Environment variable not found: DATABASE_URL", P1012).
DATABASE_URL="mysql://root@localhost:3306/9drive"

# Hosted MySQL (Aiven, PlanetScale, Azure, RDS, ...) works the same way, with one
# caveat: Prisma's MySQL connector does not read "ssl-mode" / "sslmode" from the
# URL, so the provider's copy-paste string (e.g. Aiven's ?ssl-mode=REQUIRED) would
# connect WITHOUT TLS. Ask for TLS the Prisma way instead:
#
#   encrypted, certificate not verified (works immediately):
#   DATABASE_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslaccept=accept_invalid_certs"
#
#   encrypted and verified (save the provider CA as prisma/certs/aiven-ca.pem;
#   sslcert paths resolve relative to backend/prisma):
#   DATABASE_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslcert=certs/aiven-ca.pem&sslaccept=strict"
#
# Verify the setup with `npm run db:check`, then apply the schema with
# `npm run db:migrate:deploy` (managed databases usually cannot create the
# shadow database that `prisma migrate dev` needs).
#
# DATABASE_CA_CERT (optional) supplies the provider's CA certificate without
# touching the filesystem layout: paste the whole ca.pem file, its base64, or a
# path to the .pem. It is written to prisma/certs/db-ca.pem and DATABASE_URL is
# switched to sslcert=certs/db-ca.pem&sslaccept=strict automatically, so
# sslaccept=accept_invalid_certs above becomes unnecessary.
#
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"
# DATABASE_CA_CERT=""   # or a path: /opt/9drive/aiven-ca.pem

# Port the Express API listens on.
APP_PORT=4000

# Frontend origin. CORS only allows this origin.
FRONTEND_URL="http://localhost:5173"

# Signing secret for access tokens. At least 32 characters, random.
JWT_ACCESS_SECRET="change-this-jwt-secret-at-least-32-chars"

# Key used to encrypt Google/S3 credentials. At least 32 characters, random.
TOKEN_ENCRYPTION_KEY="change-this-encryption-key-32bytes!"

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_BYTES=5368709120

# Turns on captcha for sign-up when paired with frontend VITE_RECAPTCHA_SITE_KEY.
RECAPTCHA_SECRET_KEY=""

# Only read by `npm run seed:google-config`, which stores them encrypted in the
# database. The app itself reads the encrypted copy from MySQL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/connected-accounts/google/callback"
