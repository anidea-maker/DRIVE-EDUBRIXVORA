# 9Drive backend environment template.
#
# Copy this file to `backend/.env` (or just run `npm run env:setup` in `backend/`,
# which creates it for you with random secrets):
#
#   cd backend && npm run env:setup
#
# `backend/.env` is git-ignored - never commit real secrets.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MySQL connection string. Prisma refuses to run without it
# ("Environment variable not found: DATABASE_URL", P1012).
DATABASE_URL="mysql://root@localhost:3306/9drive"

# Hosted MySQL (Aiven, PlanetScale, Azure, RDS, ...) works the same way, with one
# caveat: Prisma's MySQL connector does not read "ssl-mode" / "sslmode" from the
# URL, so the provider's copy-paste string (e.g. Aiven's ?ssl-mode=REQUIRED) would
# connect WITHOUT TLS. Ask for TLS the Prisma way instead:
#
#   encrypted, certificate not verified (works immediately):
#   DATABASE_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslaccept=accept_invalid_certs"
#
#   encrypted and verified (save the provider CA as prisma/certs/aiven-ca.pem;
#   sslcert paths resolve relative to backend/prisma):
#   DATABASE_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslcert=certs/aiven-ca.pem&sslaccept=strict"
#
# Verify the setup with `npm run db:check`, then apply the schema with
# `npm run db:migrate:deploy` (managed databases usually cannot create the
# shadow database that `prisma migrate dev` needs).
#
# DATABASE_CA_CERT (optional) supplies the provider's CA certificate without
# touching the filesystem layout: paste the whole ca.pem file, its base64, or a
# path to the .pem. It is written to prisma/certs/db-ca.pem and DATABASE_URL is
# switched to sslcert=certs/db-ca.pem&sslaccept=strict automatically, so
# sslaccept=accept_invalid_certs above becomes unnecessary.
#
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"
# DATABASE_CA_CERT=""   # or a path: /opt/9drive/aiven-ca.pem

# Port the Express API listens on.
APP_PORT=4000

# Frontend origin. CORS only allows this origin.
FRONTEND_URL="http://localhost:5173"

# Signing secret for access tokens. At least 32 characters, random.
JWT_ACCESS_SECRET="change-this-jwt-secret-at-least-32-chars"

# Key used to encrypt Google/S3 credentials. At least 32 characters, random.
TOKEN_ENCRYPTION_KEY="change-this-encryption-key-32bytes!"

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_BYTES=5368709120

# Storage API (/api/v1) - the endpoint another website calls with an API key.
# Requests per minute per key. 0 disables the limit.
API_RATE_LIMIT_PER_MINUTE=600
# Origin used in share/download URLs handed to API clients. Only needed behind a
# proxy that rewrites the Host header; by default the request's own origin is used.
# PUBLIC_BASE_URL="https://drive.example.com"
# Signs the expiring object URLs (POST /api/v1/objects/sign). Leave it empty and a
# key is derived from TOKEN_ENCRYPTION_KEY, which needs no configuration.
# OBJECT_URL_SIGNING_SECRET="

# Only read by `npm run seed:google-config`, which stores them encrypted in the
# database. The app itself reads the encrypted copy from MySQL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/connected-accounts/google/callback"

# ---------------------------------------------------------------------------
# Optional: storage backends described by the environment
# ---------------------------------------------------------------------------
# Lets "Connect S3" in Settings use credentials that already live here - the
# browser only picks a backend, the secrets never leave the server. Values that
# are still placeholders (<...>, "your-...") are ignored, and a backend with a
# missing variable is reported in GET /api/diagnostics instead of failing at
# connect time. Manual entry in Settings keeps working for anything else.

# Which backend to preselect: b2 | idrive_e2 | dbrij | custom (optional).
# A comma-separated preference list works too (b2,dbrij); `s3` means
# "the first complete backend".
STORAGE_BACKEND=

# Backblaze B2 (endpoint is derived: https://s3.<region>.backblazeb2.com)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_REGION=
# Optional: the account's name in the app.
B2_DISPLAY_NAME=
# Optional: cap shown as the account's total. Plain number in MB, or a plan size
# in GB (5, 10, 20 ...). Without it the account reads "Unlimited".
B2_STORAGE_MAX_GB=
# Optional: overrides the derived endpoint
B2_ENDPOINT_URL=

# IDrive E2 (the endpoint is per account - copy it from the console)
IDRIVE_E2_KEY_ID=
IDRIVE_E2_SECRET_KEY=
IDRIVE_E2_BUCKET=
IDRIVE_E2_ENDPOINT_URL=
IDRIVE_E2_REGION=
# Optional: the account's name in the app. A size in the name sets the quota too,
# e.g. IDRIVE_E2_DISPLAY_NAME="IDrive E2-10gb" implies 10 GB.
IDRIVE_E2_DISPLAY_NAME=
# Optional: the plan size. IDrive E2 reports no quota, so without this (or a size in
# the display name) the account reads "Unlimited". Either form works.
IDRIVE_E2_STORAGE_MAX_GB=
IDRIVE_E2_STORAGE_MAX_MB=

# Dbrij Storage (S3-compatible). Endpoint https://s3.dbrij.com, region fsn1,
# path-style. The panel publishes this block and an AWS_* block for "S3 tools and
# SDKs"; either is read, so pasting just that one works too.
# NOTE: if the panel gives a REST URL such as https://api.dbrij.com/api/storage,
# it is ignored (that host answers JSON, not S3 XML) and https://s3.dbrij.com is
# used instead.
DBRIJ_STORAGE_URL=https://s3.dbrij.com
DBRIJ_STORAGE_ACCESS_KEY=
DBRIJ_STORAGE_SECRET_KEY=
# Optional: the bucket. Leave blank to use the only bucket on the account.
DBRIJ_STORAGE_BUCKET=
# Optional: defaults to fsn1 (falls back to AWS_REGION when that is set).
DBRIJ_REGION=
# Optional: the account's name in the app. A size in the name sets the quota too,
# e.g. DBRIJ_DISPLAY_NAME=dbrij-5gb implies 5 GB.
DBRIJ_DISPLAY_NAME=
# Optional: the plan size. Without it (or a size in the display name) the account
# reads "Unlimited".
DBRIJ_STORAGE_MAX_GB=
DBRIJ_STORAGE_MAX_MB=

# Any other S3-compatible provider (Storj, Hetzner, Tigris, DigitalOcean Spaces,
# Linode, Scaleway, MinIO, AWS, ...). Appears in Settings only once one of these
# is set. Examples:
#   Storj      S3_ENDPOINT_URL=https://gateway.storjshare.io  S3_REGION=us-east-1
#   Hetzner    S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com  S3_REGION=fsn1
#   Tigris     S3_ENDPOINT_URL=https://t3.storage.dev  S3_REGION=auto
#
# The standard AWS names are read as well, so a provider block written for the AWS
# CLI/SDKs works unchanged (this is what hosting panels publish):
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_ENDPOINT_URL_S3 / AWS_REGION
# and provider-prefixed pairs such as:
#   DBRIJ_STORAGE_URL / DBRIJ_STORAGE_ACCESS_KEY / DBRIJ_STORAGE_SECRET_KEY
# The provider is named from the endpoint host (Hetzner, Storj, Tigris, ...) unless
# S3_LABEL says otherwise, and a bucket at the end of a storage URL is split off
# automatically. S3_BUCKET may be left blank when the account holds exactly one
# bucket: the server lists the buckets with these credentials and uses it.
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: path-style addressing. Defaults to true when an endpoint is set.
S3_FORCE_PATH_STYLE=
# Optional: the name shown in Settings (e.g. Storj, Hetzner).
S3_LABEL=
# Optional: the plan size, in GB or MB.
S3_STORAGE_MAX_GB=
S3_STORAGE_MAX_MB=
