# Bundled MySQL container (used by docker-compose.yml).
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=9drive
MYSQL_USER=9drive
MYSQL_PASSWORD=change-this-database-password

# Use a managed MySQL instead of the bundled container (Aiven, PlanetScale, RDS,
# Azure, ...): uncomment this and start with
#   docker compose -f docker-compose.yml -f docker-compose.external-db.yml up -d --build
# Prisma MySQL ignores "ssl-mode"/"sslmode", so ask for TLS with sslaccept:
#   ...?sslaccept=accept_invalid_certs      (encrypted, certificate not verified)
#   ...?sslcert=certs/aiven-ca.pem&sslaccept=strict  (verified; CA goes in backend/prisma/certs)
# DATABASE_URL=mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslaccept=accept_invalid_certs
# Optional: paste the provider CA (ca.pem contents, base64, or a path) to switch to
# verified TLS - DATABASE_URL is upgraded to sslcert=certs/db-ca.pem&sslaccept=strict.
# DATABASE_CA_CERT=

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_RECAPTCHA_SITE_KEY=

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
RECAPTCHA_SECRET_KEY=
