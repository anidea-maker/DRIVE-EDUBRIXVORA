# Bundled local SQLite (used by docker-compose.yml):
# the database lives in the `sqlite_data` volume, nothing else to configure.
# DATABASE_URL=file:/data/9drive.db

# Hosted Turso instead of the bundled file:
#   docker compose -f docker-compose.yml -f docker-compose.turso.yml up -d --build
# Copy both values from the Turso dashboard (or `turso db show <db> --url` and
# `turso db tokens create <db>`). A single
# DATABASE_URL="libsql://...?authToken=..." also works.
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
