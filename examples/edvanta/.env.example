# Edvanta SERVER environment only. Never prefix these with VITE_, NEXT_PUBLIC_,
# REACT_APP_ or anything else that ends up in a browser bundle.
#
# EduBrixVora API index: https://drive-edubrixvora-1.onrender.com/api/v1
STORAGE_ENDPOINT=https://drive-edubrixvora-1.onrender.com/api/v1
# Create in EduBrixVora -> API Management. Scopes: files:read, files:write,
# files:delete. The key owner must have the admin or super_admin role.
# The secret is shown once and stored hashed. There are no placeholder keys that
# work: an empty value makes createStorage() throw at startup.
STORAGE_API_KEY=
# Upstream timeout for metadata/preview/health calls. Large uploads and ZIPs
# stream; set a longer proxy timeout on Edvanta's own HTTP server too.
STORAGE_TIMEOUT_MS=15000
